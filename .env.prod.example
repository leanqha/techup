# Production environment for the TechUp API.
#
# How it's used:
#   - CI: the deploy workflow (.github/workflows/deploy-prod.yml) builds this
#     file as `.env.prod` on the server from GitHub Actions secrets (repo
#     Settings -> Environments -> "prod" -> Secrets). Each value below maps 1:1
#     to a secret of the same name.
#   - Manual: copy to `.env.prod`, fill in, then `make deploy ENV_FILE=./.env.prod`.
#
# Values marked (SECRET) must be set as GitHub secrets; never commit real ones.

# --- Application ---
PORT=3000                              # host port the API is published on
GIN_MODE=release                       # release in prod
APP_BASE_URL=https://your-domain.tld   # public base URL (used in reset links/emails)
# Auth cookie Secure flag. Leave unset to follow GIN_MODE (on in release).
# Set to false when serving over plain HTTP (e.g. an IP, no TLS) so logins work.
COOKIE_SECURE=true

# --- Database (the containerized Postgres from docker-compose) ---
DB_HOST=db                             # compose service name; the app reaches it here
DB_PORT=5432
DB_USER=techup
DB_PASSWORD=change-me                  # (SECRET) strong password
DB_NAME=techup_db
DB_SSLMODE=disable                     # traffic stays on the internal compose network

# --- JWT ---
JWT_SECRET=change-me                   # (SECRET) long random string, e.g. `openssl rand -hex 32`
JWT_ACCESS_TOKEN_TTL=15                # minutes
JWT_REFRESH_TOKEN_TTL=10080            # minutes (7 days)

# --- Password reset ---
PASSWORD_RESET_TTL_MINUTES=30

# --- Goose migrations (used by the migrate container) ---
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./migrations

# --- SMTP (optional; leave blank to log reset links instead of sending email) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_SKIP_VERIFY=false
SMTP_USER=
SMTP_PASS=                             # (SECRET)
SMTP_FROM=
