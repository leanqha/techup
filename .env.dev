# Local development environment (safe, non-secret defaults).
# Used by `make dev`, `make dev-setup` and the optional `app` compose service.

# Application
PORT=3000
GIN_MODE=debug
APP_BASE_URL=http://localhost:5173

# Database — matches the docker-compose `db` service defaults
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=techup_db
DB_SSLMODE=disable

# JWT (dev-only secret — never use in production)
JWT_SECRET=dev-secret-not-for-production
JWT_ACCESS_TOKEN_TTL=15
JWT_REFRESH_TOKEN_TTL=10080

# Password reset
PASSWORD_RESET_TTL_MINUTES=30

# Goose migrations
GOOSE_MIGRATION_DIR=./migrations
GOOSE_DRIVER=postgres

# SMTP (optional; left empty so password-reset links are logged instead of mailed)
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_SKIP_VERIFY=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
