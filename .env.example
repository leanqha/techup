# Application
PORT=3000
GIN_MODE=release
APP_BASE_URL=https://example.com

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=techup_db
DB_SSLMODE=disable

# JWT
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL=15
JWT_REFRESH_TOKEN_TTL=10080

# Password reset
PASSWORD_RESET_TTL_MINUTES=30

# Goose
GOOSE_MIGRATION_DIR=./migrations
GOOSE_DRIVER=postgres

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_SKIP_VERIFY=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=notifications
RABBITMQ_MAIN_QUEUE=notifications.main
RABBITMQ_RETRY_QUEUE=notifications.retry
RABBITMQ_DLQ=notifications.dlq
RABBITMQ_MAIN_ROUTING_KEY=notifications.main
RABBITMQ_RETRY_ROUTING_KEY=notifications.retry
RABBITMQ_DLQ_ROUTING_KEY=notifications.dlq
RABBITMQ_RETRY_DELAY_MS=15000
RABBITMQ_MAX_RETRIES=5
RABBITMQ_PREFETCH=10

